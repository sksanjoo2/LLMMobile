<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- HTTPS only, system CAs only (user-installed CAs are NOT trusted, which blocks MITM proxies). -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
